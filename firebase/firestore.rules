rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function ownProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasOwnProfile() {
      return isAuthenticated() && exists(ownProfilePath());
    }

    function ownData() {
      return get(ownProfilePath()).data;
    }

    /** Email del token Auth (fuente de verdad; no depende del doc users). */
    function authEmailIsSuperAdmin() {
      return isAuthenticated()
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^felimq09@gmail\\.com$');
    }

    function profileIsSuperAdmin() {
      return hasOwnProfile() && (
        ownData().role == 'super_admin'
        || (ownData().email is string
            && ownData().email.matches('(?i)^felimq09@gmail\\.com$'))
      );
    }

    function isSuperAdmin() {
      return authEmailIsSuperAdmin() || profileIsSuperAdmin();
    }

    function isBrandAdmin() {
      return isSuperAdmin()
        || (hasOwnProfile()
          && ownData().pendingApproval != true
          && ownData().active != false
          && (ownData().role == 'admin' || ownData().role == 'owner'));
    }

    function missingBrandId(data) {
      return !('brandId' in data)
        || data.brandId == null
        || data.brandId == '';
    }

    /**
     * Marca del usuario. Legacy sin brandId → advance-coat.
     * Debe coincidir con el where('brandId' == …) del cliente para que list funcione.
     * OJO: no usar keys().hasAll / "is string" en paths de list (rompe queries).
     */
    function userBrandId() {
      return hasOwnProfile() && !missingBrandId(ownData())
        ? ownData().brandId
        : 'advance-coat';
    }

    function isAdvanceUser() {
      return isSuperAdmin()
        || (isActiveMember()
          && (missingBrandId(ownData()) || ownData().brandId == 'advance-coat'));
    }

    function isAdvanceDoc(data) {
      return missingBrandId(data) || data.brandId == 'advance-coat';
    }

    /** Lectura de un doc (get): admite legacy Advance sin brandId. */
    function sameBrandGet(data) {
      return isSuperAdmin()
        || (isActiveMember() && data.brandId == userBrandId())
        || (isAdvanceUser() && isAdvanceDoc(data));
    }

    /**
     * List/query: el cliente DEBE filtrar where('brandId' == …).
     * Super admin bypasea sin filtro (por eso él ve datos y el empleado no).
     * Regla alineada al constraint de la query — sin keys()/is string.
     */
    function sameBrandList(data) {
      return isSuperAdmin()
        || (isActiveMember() && data.brandId == userBrandId())
        || (isAdvanceUser() && data.brandId == 'advance-coat');
    }

    function sameBrand(data) {
      return sameBrandGet(data);
    }

    function brandWriteOk() {
      return isSuperAdmin()
        || (hasOwnProfile()
            && !missingBrandId(request.resource.data)
            && request.resource.data.brandId == userBrandId())
        || (isAdvanceUser()
            && !missingBrandId(request.resource.data)
            && request.resource.data.brandId == 'advance-coat')
        || (isAdvanceUser() && missingBrandId(request.resource.data));
    }

    function stockOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stock'])
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'brandId']);
    }

    function canSelfSealAdvanceBrand(uid) {
      return request.auth.uid == uid
        && request.resource.data.brandId == 'advance-coat'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['brandId'])
        && (
          missingBrandId(resource.data)
          || !exists(/databases/$(database)/documents/brands/$(resource.data.brandId))
        );
    }

    function isActiveMember() {
      return isSuperAdmin()
        || (hasOwnProfile()
          && ownData().pendingApproval != true
          && ownData().active != false);
    }

    function employeeSelfJoinOk(uid) {
      return request.auth.uid == uid
        && request.resource.data.role == 'employee'
        && request.resource.data.pendingApproval == true
        && request.resource.data.active == false
        && request.resource.data.brandId is string
        && request.resource.data.brandId.size() > 0
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/brands/$(request.resource.data.brandId))
        && get(/databases/$(database)/documents/brands/$(request.resource.data.brandId)).data.inviteCode
            == request.resource.data.inviteCode;
    }

    match /users/{userId} {
      allow get: if isAuthenticated()
        && (request.auth.uid == userId
            || isBrandAdmin()
            || isSuperAdmin());
      allow list: if isBrandAdmin() || isSuperAdmin();
      allow create: if isSuperAdmin()
        || isBrandAdmin()
        || (request.auth.uid == userId
            && request.resource.data.role == 'owner'
            && request.resource.data.brandId is string
            && request.resource.data.brandId.size() > 0)
        || employeeSelfJoinOk(userId);
      allow update: if isSuperAdmin()
        || isBrandAdmin()
        || canSelfSealAdvanceBrand(userId)
        || (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'active', 'brandId', 'pendingApproval', 'inviteCode']));
      allow delete: if isSuperAdmin() || isBrandAdmin();
    }

    match /brands/{brandId} {
      allow get: if isAuthenticated()
        && (
          isSuperAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (hasOwnProfile() && userBrandId() == brandId)
          || (isAdvanceUser() && brandId == 'advance-coat')
        );
      allow list: if isSuperAdmin() || isAuthenticated();
      allow create: if isAuthenticated()
        && (isSuperAdmin()
            || request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isSuperAdmin()
        || (hasOwnProfile() && isBrandAdmin() && userBrandId() == brandId);
    }

    match /products/{productId} {
      allow get: if isSuperAdmin() || sameBrandGet(resource.data);
      allow list: if sameBrandList(resource.data);
      allow create: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && brandWriteOk());
      allow update: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && sameBrand(resource.data)
          && (brandWriteOk() || stockOnlyUpdate()));
      allow delete: if isSuperAdmin() || (isBrandAdmin() && sameBrand(resource.data));
    }

    match /sales/{saleId} {
      allow get: if isSuperAdmin() || sameBrandGet(resource.data);
      allow list: if sameBrandList(resource.data);
      allow create: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && brandWriteOk());
      allow update: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && sameBrand(resource.data)
          && (brandWriteOk() || stockOnlyUpdate()));
      allow delete: if isSuperAdmin() || (isBrandAdmin() && sameBrand(resource.data));
    }

    match /saleDrafts/{draftId} {
      allow get: if isSuperAdmin() || sameBrandGet(resource.data);
      allow list: if sameBrandList(resource.data);
      allow delete: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && sameBrand(resource.data));
      allow create: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && brandWriteOk());
      allow update: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && sameBrand(resource.data) && brandWriteOk());
    }

    match /caja/{dateId} {
      allow get: if isSuperAdmin() || sameBrandGet(resource.data);
      allow list: if sameBrandList(resource.data);
      allow create: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && brandWriteOk());
      allow update: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && sameBrand(resource.data) && (
          isBrandAdmin()
          || request.resource.data.brandId == userBrandId()
          || (isAdvanceUser() && request.resource.data.brandId == 'advance-coat')
        ));
      allow delete: if isSuperAdmin() || (isBrandAdmin() && sameBrand(resource.data));
    }

    match /cajaCentral/{docId} {
      allow read, write: if isSuperAdmin();
      allow get: if isAuthenticated();
      allow list: if isBrandAdmin() || isSuperAdmin();
      allow create: if isAuthenticated() && brandWriteOk();
      allow update: if isAuthenticated() && (
        isBrandAdmin()
        || isSuperAdmin()
        || request.resource.data.balance >= resource.data.balance
      );
      allow delete: if isBrandAdmin() || isSuperAdmin();
    }

    match /cajaCentralMovements/{movementId} {
      allow get: if isSuperAdmin() || (
        isAuthenticated() && (isBrandAdmin() || isSuperAdmin()) && sameBrandGet(resource.data)
      );
      allow list: if isSuperAdmin() || (
        isAuthenticated() && (isBrandAdmin() || isSuperAdmin()) && sameBrandList(resource.data)
      );
      allow create: if isSuperAdmin() || (isAuthenticated() && brandWriteOk() && (
        request.resource.data.type == 'deposito'
        || ((request.resource.data.type == 'retiro') && isBrandAdmin())
      ));
      allow update, delete: if isBrandAdmin() || isSuperAdmin();
    }

    match /customers/{customerId} {
      allow get: if isSuperAdmin() || sameBrandGet(resource.data);
      allow list: if sameBrandList(resource.data);
      allow create: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && brandWriteOk());
      allow update, delete: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && sameBrand(resource.data));
    }

    match /presupuestos/{presupuestoId} {
      allow get: if isSuperAdmin() || sameBrandGet(resource.data);
      allow list: if sameBrandList(resource.data);
      allow create: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && brandWriteOk());
      allow update, delete: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && sameBrand(resource.data));
    }

    match /flexShipments/{shipmentId} {
      allow get: if isSuperAdmin() || sameBrandGet(resource.data);
      allow list: if sameBrandList(resource.data);
      allow create: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && brandWriteOk());
      allow update, delete: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && sameBrand(resource.data));
    }

    match /auditLogs/{logId} {
      allow get: if isSuperAdmin() || (isAuthenticated() && (isBrandAdmin() || isSuperAdmin()));
      allow list: if isSuperAdmin() || (isAuthenticated() && (isBrandAdmin() || isSuperAdmin()));
      allow create: if isSuperAdmin()
        || (isAuthenticated() && isActiveMember() && brandWriteOk());
      allow update, delete: if isSuperAdmin();
    }
  }
}
