rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function ownProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasOwnProfile() {
      return isAuthenticated() && exists(ownProfilePath());
    }

    function isAdmin() {
      return hasOwnProfile() && get(ownProfilePath()).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin();
      // Empleados pueden editar datos propios, nunca role ni active.
      allow update: if isAdmin()
        || (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'active']));
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /caja/{dateId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Caja central: get autenticado (depósitos al cerrar); list/UI saldo solo admin.
    // Update: empleados solo pueden incrementar balance; retiros (decremento) solo admin.
    match /cajaCentral/{docId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin()
        || request.resource.data.balance >= resource.data.balance
      );
      allow delete: if isAdmin();
    }

    match /cajaCentralMovements/{movementId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (
        request.resource.data.type == 'deposito'
        || (request.resource.data.type == 'retiro' && isAdmin())
      );
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /presupuestos/{presupuestoId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /flexShipments/{shipmentId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}
