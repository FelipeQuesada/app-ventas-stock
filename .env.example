# Mobile (Expo) — copiar a mobile/.env
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web (Vite) — copiar a web/.env (mismos valores)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tiendanube — DESCONECTADA por ahora.
# Cuando armes una app/cuenta nueva en Partners:
# VITE_TIENDANUBE_ENABLED=true
# VITE_TIENDANUBE_STORE_ID=
# VITE_TIENDANUBE_TOKEN=
VITE_TIENDANUBE_ENABLED=false

# Telegram (Cloud Functions — NO va en web/mobile ni en Vercel)
# El token se guarda solo en Firebase Secrets:
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN
# El chat_id del grupo vive solo en functions/ (servidor), no en el front.

