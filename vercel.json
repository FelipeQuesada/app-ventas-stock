{
  "installCommand": "npm install",
  "buildCommand": "npm run web:build",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/tiendanube/:path*",
      "destination": "https://api.tiendanube.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
