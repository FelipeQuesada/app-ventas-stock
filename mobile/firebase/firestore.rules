rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function ownProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasOwnProfile() {
      return isAuthenticated() && exists(ownProfilePath());
    }

    function ownData() {
      return get(ownProfilePath()).data;
    }

    function isSuperAdmin() {
      return hasOwnProfile() && (
        ownData().role == 'super_admin'
        || ownData().email == 'felimq09@gmail.com'
      );
    }

    function isBrandAdmin() {
      return hasOwnProfile() && (
        ownData().role == 'admin'
        || ownData().role == 'owner'
        || isSuperAdmin()
      );
    }

    function userBrandId() {
      return ownData().brandId;
    }

    function sameBrand(data) {
      return isSuperAdmin()
        || (hasOwnProfile() && data.brandId == userBrandId())
        // legacy Advance sin brandId
        || (hasOwnProfile()
            && userBrandId() == 'advance-coat'
            && !('brandId' in data));
    }

    function brandWriteOk() {
      return isSuperAdmin()
        || (hasOwnProfile()
            && request.resource.data.brandId == userBrandId());
    }

    match /users/{userId} {
      allow get: if isAuthenticated()
        && (request.auth.uid == userId
            || isBrandAdmin()
            || isSuperAdmin());
      allow list: if isBrandAdmin() || isSuperAdmin();
      // Admin de marca crea empleados; el dueño se auto-crea en el registro.
      allow create: if isSuperAdmin()
        || isBrandAdmin()
        || (request.auth.uid == userId
            && request.resource.data.role == 'owner'
            && request.resource.data.email == request.auth.token.email);
      allow update: if isSuperAdmin()
        || isBrandAdmin()
        || (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'active', 'brandId']));
      allow delete: if isSuperAdmin() || isBrandAdmin();
    }

    match /brands/{brandId} {
      allow get: if isAuthenticated()
        && (
          isSuperAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (hasOwnProfile() && userBrandId() == brandId)
        );
      allow list: if isSuperAdmin()
        || isAuthenticated(); // chequeo de slug en registro; datos no sensibles
      allow create: if isAuthenticated()
        && (isSuperAdmin()
            || request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isSuperAdmin()
        || (hasOwnProfile() && isBrandAdmin() && userBrandId() == brandId);
    }

    match /products/{productId} {
      allow read: if isAuthenticated() && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk();
      allow update: if isAuthenticated() && sameBrand(resource.data) && brandWriteOk();
      allow delete: if isBrandAdmin() && sameBrand(resource.data);
    }

    match /sales/{saleId} {
      allow read: if isAuthenticated() && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk();
      allow update: if isAuthenticated() && sameBrand(resource.data) && brandWriteOk();
      allow delete: if isBrandAdmin() && sameBrand(resource.data);
    }

    match /saleDrafts/{draftId} {
      allow read, delete: if isAuthenticated() && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk();
      allow update: if isAuthenticated() && sameBrand(resource.data) && brandWriteOk();
    }

    match /caja/{dateId} {
      allow read: if isAuthenticated() && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk();
      allow update: if isAuthenticated() && sameBrand(resource.data) && (
        isBrandAdmin()
        || request.resource.data.brandId == userBrandId()
      );
      allow delete: if isBrandAdmin() && sameBrand(resource.data);
    }

    match /cajaCentral/{docId} {
      allow get: if isAuthenticated();
      allow list: if isBrandAdmin() || isSuperAdmin();
      allow create: if isAuthenticated() && brandWriteOk();
      allow update: if isAuthenticated() && (
        isBrandAdmin()
        || isSuperAdmin()
        || request.resource.data.balance >= resource.data.balance
      );
      allow delete: if isBrandAdmin() || isSuperAdmin();
    }

    match /cajaCentralMovements/{movementId} {
      allow read: if isAuthenticated() && (isBrandAdmin() || isSuperAdmin())
        && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk() && (
        request.resource.data.type == 'deposito'
        || ((request.resource.data.type == 'retiro') && isBrandAdmin())
      );
      allow update, delete: if isBrandAdmin() || isSuperAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAuthenticated() && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk();
      allow update, delete: if isAuthenticated() && sameBrand(resource.data);
    }

    match /presupuestos/{presupuestoId} {
      allow read: if isAuthenticated() && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk();
      allow update, delete: if isAuthenticated() && sameBrand(resource.data);
    }

    match /flexShipments/{shipmentId} {
      allow read: if isAuthenticated() && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk();
      allow update, delete: if isAuthenticated() && sameBrand(resource.data);
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (isBrandAdmin() || isSuperAdmin());
      allow create: if isAuthenticated() && brandWriteOk();
    }
  }
}
