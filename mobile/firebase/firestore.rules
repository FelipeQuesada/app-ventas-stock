rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function ownProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasOwnProfile() {
      return isAuthenticated() && exists(ownProfilePath());
    }

    function ownData() {
      return get(ownProfilePath()).data;
    }

    function isSuperAdmin() {
      return hasOwnProfile() && (
        ownData().role == 'super_admin'
        || ownData().email == 'felimq09@gmail.com'
      );
    }

    function isBrandAdmin() {
      return hasOwnProfile()
        && ownData().pendingApproval != true
        && ownData().active != false
        && (
          ownData().role == 'admin'
          || ownData().role == 'owner'
          || isSuperAdmin()
        );
    }

    function missingBrandId(data) {
      return !('brandId' in data)
        || data.brandId == null
        || data.brandId == '';
    }

    /** Legacy Advance: perfil sin brandId opera como advance-coat (no super_admin). */
    function userBrandId() {
      return isSuperAdmin()
        ? null
        : (hasOwnProfile() && !missingBrandId(ownData())
            ? ownData().brandId
            : 'advance-coat');
    }

    function isAdvanceUser() {
      return hasOwnProfile()
        && ownData().pendingApproval != true
        && ownData().active != false
        && (missingBrandId(ownData()) || ownData().brandId == 'advance-coat');
    }

    function isAdvanceDoc(data) {
      return missingBrandId(data) || data.brandId == 'advance-coat';
    }

    function sameBrand(data) {
      return isSuperAdmin()
        || (hasOwnProfile() && data.brandId == userBrandId())
        // Advance: docs legacy o marcados advance-coat
        || (isAdvanceUser() && isAdvanceDoc(data));
    }

    function brandWriteOk() {
      return isSuperAdmin()
        || (hasOwnProfile()
            && !missingBrandId(request.resource.data)
            && request.resource.data.brandId == userBrandId())
        || (isAdvanceUser()
            && !missingBrandId(request.resource.data)
            && request.resource.data.brandId == 'advance-coat')
        || (isAdvanceUser() && missingBrandId(request.resource.data));
    }

    /** Update de stock (y sellado opcional de brandId legacy) */
    function stockOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stock'])
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'brandId']);
    }

    function canSelfSealAdvanceBrand(uid) {
      return request.auth.uid == uid
        && !isSuperAdmin()
        && request.resource.data.brandId == 'advance-coat'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['brandId'])
        && (
          missingBrandId(resource.data)
          || !exists(/databases/$(database)/documents/brands/$(resource.data.brandId))
        );
    }

    function isActiveMember() {
      return hasOwnProfile()
        && ownData().pendingApproval != true
        && ownData().active != false;
    }

    function employeeSelfJoinOk(uid) {
      return request.auth.uid == uid
        && request.resource.data.role == 'employee'
        && request.resource.data.pendingApproval == true
        && request.resource.data.active == false
        && request.resource.data.brandId is string
        && request.resource.data.brandId.size() > 0
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/brands/$(request.resource.data.brandId))
        && get(/databases/$(database)/documents/brands/$(request.resource.data.brandId)).data.inviteCode
            == request.resource.data.inviteCode;
    }

    match /users/{userId} {
      allow get: if isAuthenticated()
        && (request.auth.uid == userId
            || isBrandAdmin()
            || isSuperAdmin());
      allow list: if isBrandAdmin() || isSuperAdmin();
      allow create: if isSuperAdmin()
        || isBrandAdmin()
        || (request.auth.uid == userId
            && request.resource.data.role == 'owner'
            && request.resource.data.brandId is string
            && request.resource.data.brandId.size() > 0)
        || employeeSelfJoinOk(userId);
      allow update: if isSuperAdmin()
        || isBrandAdmin()
        || canSelfSealAdvanceBrand(userId)
        || (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'active', 'brandId', 'pendingApproval', 'inviteCode']));
      allow delete: if isSuperAdmin() || isBrandAdmin();
    }

    match /brands/{brandId} {
      allow get: if isAuthenticated()
        && (
          isSuperAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (hasOwnProfile() && userBrandId() == brandId)
        );
      allow list: if isSuperAdmin()
        || isAuthenticated();
      allow create: if isAuthenticated()
        && (isSuperAdmin()
            || request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isSuperAdmin()
        || (hasOwnProfile() && isBrandAdmin() && userBrandId() == brandId);
    }

    match /products/{productId} {
      allow read, update: if isSuperAdmin();
      allow read: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
      allow create: if isAuthenticated() && isActiveMember() && brandWriteOk();
      allow update: if isAuthenticated() && isActiveMember() && sameBrand(resource.data)
        && (brandWriteOk() || stockOnlyUpdate());
      allow delete: if isBrandAdmin() && sameBrand(resource.data);
    }

    match /sales/{saleId} {
      allow read, update: if isSuperAdmin();
      allow read: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
      allow create: if isAuthenticated() && isActiveMember() && (
        brandWriteOk()
        || (isAdvanceUser() && request.resource.data.brandId == 'advance-coat')
      );
      allow update: if isAuthenticated() && isActiveMember() && sameBrand(resource.data)
        && (brandWriteOk() || stockOnlyUpdate());
      allow delete: if isBrandAdmin() && sameBrand(resource.data);
    }

    match /saleDrafts/{draftId} {
      allow read, update, delete: if isSuperAdmin();
      allow read, delete: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
      allow create: if isAuthenticated() && isActiveMember() && brandWriteOk();
      allow update: if isAuthenticated() && isActiveMember() && sameBrand(resource.data) && brandWriteOk();
    }

    match /caja/{dateId} {
      allow read, update: if isSuperAdmin();
      allow read: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
      allow create: if isAuthenticated() && isActiveMember() && brandWriteOk();
      allow update: if isAuthenticated() && isActiveMember() && sameBrand(resource.data) && (
        isBrandAdmin()
        || request.resource.data.brandId == userBrandId()
      );
      allow delete: if isBrandAdmin() && sameBrand(resource.data);
    }

    match /cajaCentral/{docId} {
      allow read, write: if isSuperAdmin();
      allow get: if isAuthenticated();
      allow list: if isBrandAdmin() || isSuperAdmin();
      allow create: if isAuthenticated() && brandWriteOk();
      allow update: if isAuthenticated() && (
        isBrandAdmin()
        || isSuperAdmin()
        || request.resource.data.balance >= resource.data.balance
      );
      allow delete: if isBrandAdmin() || isSuperAdmin();
    }

    match /cajaCentralMovements/{movementId} {
      allow read, write: if isSuperAdmin();
      allow read: if isAuthenticated() && (isBrandAdmin() || isSuperAdmin())
        && sameBrand(resource.data);
      allow create: if isAuthenticated() && brandWriteOk() && (
        request.resource.data.type == 'deposito'
        || ((request.resource.data.type == 'retiro') && isBrandAdmin())
      );
      allow update, delete: if isBrandAdmin() || isSuperAdmin();
    }

    match /customers/{customerId} {
      allow read, update, delete: if isSuperAdmin();
      allow read: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
      allow create: if isAuthenticated() && isActiveMember() && brandWriteOk();
      allow update, delete: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
    }

    match /presupuestos/{presupuestoId} {
      allow read, update, delete: if isSuperAdmin();
      allow read: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
      allow create: if isAuthenticated() && isActiveMember() && brandWriteOk();
      allow update, delete: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
    }

    match /flexShipments/{shipmentId} {
      allow read, update, delete: if isSuperAdmin();
      allow read: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
      allow create: if isAuthenticated() && isActiveMember() && brandWriteOk();
      allow update, delete: if isAuthenticated() && isActiveMember() && sameBrand(resource.data);
    }

    match /auditLogs/{logId} {
      allow read, update: if isSuperAdmin();
      allow read: if isAuthenticated() && (isBrandAdmin() || isSuperAdmin());
      allow create: if isAuthenticated() && isActiveMember() && brandWriteOk();
    }
  }
}
