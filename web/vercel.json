{
  "installCommand": "cd .. && npm install",
  "buildCommand": "cd .. && npm run web:build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "controlmas.app" }],
      "destination": "https://controlmas.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.controlmas.app" }],
      "destination": "https://controlmas.com.ar/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
